<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_ignore_dialog">

    <!-- Title Row with Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvIgnoreDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Добавление в игнор-лист"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseIgnoreDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#9CA3AF"
            android:contentDescription="Закрыть"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Comment Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Комментарий (необязательно)"
        android:textColor="#9CA3AF"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans" />

    <!-- Comment Input Field -->
    <EditText
        android:id="@+id/etIgnoreComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@drawable/bg_ignore_input"
        android:hint="Позволит вам помнить причину по которой вы добавили пользователя в игнор-лист"
        android:textColorHint="#6B7280"
        android:textColor="#FFFFFF"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans"
        android:inputType="textMultiLine"
        android:importantForAutofill="no" />

    <!-- Info Card "Что позволяет игнор-лист?" -->
    <LinearLayout
        android:id="@+id/ignoreInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_ignore_info_card"
        android:padding="14dp">

        <!-- Info Header (Clickable for collapse/expand) -->
        <LinearLayout
            android:id="@+id/btnToggleIgnoreInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Что позволяет игнор-лист?"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivIgnoreInfoChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_up"
                app:tint="#9CA3AF"
                android:contentDescription="Свернуть/Развернуть" />
        </LinearLayout>

        <!-- Bullet Points Container -->
        <LinearLayout
            android:id="@+id/ignoreInfoContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Скрывает комментарии этого пользователя"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Запрещает этому пользователю отвечать на ваши комментарии"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Запрещает этому пользователю писать вам личные сообщения"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Запрещает этому пользователю писать в вашей теме или отвечать на ваши посты форума"
                android:textColor="#D1D5DB"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/btnCancelIgnore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="Отмена"
            android:textColor="#D1D5DB"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_semibold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnConfirmIgnore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="18dp"
            android:paddingVertical="10dp"
            android:text="Добавить в игнор"
            android:textColor="#FCA5A5"
            android:textSize="14sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_ignore_danger"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
