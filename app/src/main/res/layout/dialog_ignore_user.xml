<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_ignore_dialog">

    <!-- Title Row with Icon, Title, and Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_btn_ignore_danger"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ignore_user"
                app:tint="@color/dialog_danger_text"
                android:contentDescription="Игнор-лист" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvIgnoreDialogTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Добавление в игнор-лист"
            android:textColor="@color/dialog_text_title"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseIgnoreDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/dialog_icon_close"
            android:contentDescription="Закрыть"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Comment Label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:text="Комментарий (необязательно)"
        android:textColor="@color/dialog_text_muted"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans" />

    <!-- Comment Input Field -->
    <EditText
        android:id="@+id/etIgnoreComment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="80dp"
        android:gravity="top|start"
        android:padding="12dp"
        android:background="@drawable/bg_ignore_input"
        android:hint="Позволит вам помнить причину по которой вы добавили пользователя в игнор-лист"
        android:textColorHint="@color/dialog_text_hint"
        android:textColor="@color/dialog_text_title"
        android:textSize="13.5sp"
        android:fontFamily="@font/open_sans"
        android:inputType="textMultiLine"
        android:importantForAutofill="no" />

    <!-- Info Card "Что позволяет игнор-лист?" -->
    <LinearLayout
        android:id="@+id/ignoreInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_ignore_info_card">

        <!-- Info Header (Clickable for collapse/expand) -->
        <LinearLayout
            android:id="@+id/btnToggleIgnoreInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_card_header_ripple">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Что позволяет игнор-лист?"
                android:textColor="@color/dialog_text_title"
                android:textSize="15sp"
                android:fontFamily="@font/open_sans_bold"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/ivIgnoreInfoChevron"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_up"
                app:tint="@color/dialog_icon_close"
                android:contentDescription="Свернуть/Развернуть" />
        </LinearLayout>

        <!-- Bullet Points Container -->
        <LinearLayout
            android:id="@+id/ignoreInfoContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Скрывает комментарии этого пользователя"
                android:textColor="@color/dialog_text_body"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Запрещает этому пользователю отвечать на ваши комментарии"
                android:textColor="@color/dialog_text_body"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="• Запрещает этому пользователю писать вам личные сообщения"
                android:textColor="@color/dialog_text_body"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Запрещает этому пользователю писать в вашей теме или отвечать на ваши посты форума"
                android:textColor="@color/dialog_text_body"
                android:textSize="13sp"
                android:fontFamily="@font/open_sans"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end|center_vertical">

        <TextView
            android:id="@+id/btnCancelIgnore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/button_padding_horizontal"
            android:paddingVertical="@dimen/button_padding_vertical"
            android:text="@string/btn_cancel"
            android:textColor="@color/dialog_cancel_text"
            android:textSize="@dimen/button_text_size_standard"
            android:fontFamily="@font/open_sans_semibold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_btn_cancel_ripple"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/btnConfirmIgnore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/button_padding_horizontal"
            android:paddingVertical="@dimen/button_padding_vertical"
            android:text="Добавить в игнор"
            android:textColor="@color/dialog_danger_text"
            android:textSize="@dimen/button_text_size_standard"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_ignore_danger"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
