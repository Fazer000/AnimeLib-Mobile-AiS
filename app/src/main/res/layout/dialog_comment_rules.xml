<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_ignore_dialog">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_ignore_info_card"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_toast_info"
                app:tint="@color/purple_primary"
                android:contentDescription="Правила" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Правила комментариев"
            android:textColor="@color/dialog_text_title"
            android:textSize="18sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseRules"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/dialog_icon_close"
            android:contentDescription="Закрыть"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Rule Item 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_ignore_info_card"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_rules_number_circle"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/dialog_rules_num_text"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Соблюдайте уважение к другим пользователям."
            android:textColor="@color/dialog_text_body"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>

    <!-- Rule Item 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_ignore_info_card"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_rules_number_circle"
            android:gravity="center"
            android:text="2"
            android:textColor="@color/dialog_rules_num_text"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Запрещен спам, оффтоп, оскорбления и реклама."
            android:textColor="@color/dialog_text_body"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>

    <!-- Rule Item 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_ignore_info_card">

        <TextView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_rules_number_circle"
            android:gravity="center"
            android:text="3"
            android:textColor="@color/dialog_rules_num_text"
            android:textSize="12sp"
            android:fontFamily="@font/open_sans_bold"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Спойлеры должны быть скрыты специальным тегом."
            android:textColor="@color/dialog_text_body"
            android:textSize="13.5sp"
            android:fontFamily="@font/open_sans"
            android:lineSpacingExtra="1dp" />
    </LinearLayout>

    <!-- Action Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnUnderstand"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="20dp"
        android:text="Понятно"
        android:textColor="@color/dialog_btn_neutral_text"
        android:textSize="14sp"
        android:fontFamily="@font/open_sans_bold"
        android:textStyle="bold"
        android:backgroundTint="@color/dialog_btn_neutral_bg"
        app:cornerRadius="8dp"
        app:strokeWidth="0dp" />

</LinearLayout>
